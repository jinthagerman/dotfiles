# Shared across machines. Identity lives in ~/.gitconfig.user (not tracked):
#   [user]
#     name = Jin Budelmann
#     email = you@example.com
[include]
  path = ~/.gitconfig.user

[core]
  editor = nvim
  excludesfile = ~/.yadr/git/gitignore
  autocrlf = false
[init]
  defaultBranch = main
[advice]
  statusHints = false

[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red
  new = green

[diff]
  algorithm = histogram
  colorMoved = default
[merge]
  conflictstyle = zdiff3
  tool = nvimdiff
[mergetool]
  prompt = false
  keepBackup = false
[rerere]
  enabled = true
[apply]
  whitespace = nowarn

[branch]
  autosetupmerge = true
  sort = -committerdate
[push]
  default = upstream
  autoSetupRemote = true   # `git push` on a new (agent-made) branch just works
[fetch]
  prune = true
[rebase]
  autoStash = true
  updateRefs = true
[worktree]
  guessRemote = true

[alias]
  a = add
  s = status
  st = status
  ci = commit
  c = commit -m
  amend = commit --amend
  co = checkout
  nb = switch -c
  b = branch -v
  cp = cherry-pick -x
  d = diff
  dc = diff --cached
  last = diff HEAD^
  l = log --graph --date=short --pretty=format:'%C(blue)%ad%Creset %C(yellow)%h%C(green)%d%Creset %C(blue)%s %C(magenta)[%an]%Creset'
  changes = log --pretty=format:\"%h %cr %cn %Cgreen%s%Creset\" --name-status
  rc = rebase --continue
  r = remote -v
  unstage = reset HEAD
  uncommit = reset --soft HEAD^
  recent-branches = for-each-ref --count=15 --sort=-committerdate refs/heads/ --format='%(refname:short)'
  snapshot = !git stash push -m \"snapshot: $(date)\" && git stash apply stash@{0}
  wt = worktree
  contributors = shortlog --summary --numbered --email

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
