# ~/.zshrc -> ~/.yadr/zsh/prezto-override/zshrc

# Agent shells (Claude Code incl. `!` mode, Codex, or anything exporting AGENT=1)
# get the same environment but none of the aliases that change how standard
# commands behave. See zsh/aliases.zsh.
if [[ -n $CLAUDECODE || -n $CODEX_SANDBOX || -n $AGENT ]]; then
  export YADR_AGENT_SHELL=1
fi

# Custom prompt themes must be on fpath before prezto's prompt module loads.
fpath=($HOME/.yadr/zsh/prezto-themes $fpath)

source $HOME/.zprezto/runcoms/zshrc

for config_file ($HOME/.yadr/zsh/*.zsh(N)) source $config_file
unset config_file

# --- Tool integrations -------------------------------------------------------

# OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# bun
export BUN_INSTALL="$HOME/.bun"
path=($BUN_INSTALL/bin $path)
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# >>> boxd completions >>>
# Managed by `boxd completions --install`; do not edit between markers.
if [ -n "${ZSH_VERSION:-}" ]; then
  whence compdef >/dev/null || { autoload -Uz compinit && compinit; }
  command -v boxd >/dev/null && source <(boxd completions zsh)
fi
# <<< boxd completions <<<
